# ─────────────────────────────────────────────────────────────
# Property Direct — environment configuration
# Copy to ".env" and fill in your own values:  cp .env.example .env
# NEVER commit your real .env (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

# Brand (temporary name — change here in ONE place, the whole site follows)
BRAND_NAME=Property Direct
BRAND_TAGLINE=Buy Direct. Sell Direct. No Middlemen.

# Secret used to sign login tokens (JWT). Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Admin account — created automatically on first server start IF both are set.
# There is NO default/hardcoded admin password. Leave empty to have no admin
# until you set these and restart. Use placeholder values only in this example.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional external AI for the Property Assistant summary (OpenAI-compatible).
# The assistant's database search works WITHOUT any key (rule-based parser).
# If set, keys are read ONLY by the server, never by the frontend.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Port the server listens on.
PORT=3000
